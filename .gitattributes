*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# Web-delivery audio is committed directly rather than through LFS. GitHub
# Pages does not resolve LFS pointers, so an LFS-tracked file publishes as an
# unplayable 133-byte stub. These are downmixed for streaming and small enough
# to live in git; the full-resolution masters stay in audio-masters/, which the
# rules above still cover.
public/audio/*.mp3 !filter !diff !merge
